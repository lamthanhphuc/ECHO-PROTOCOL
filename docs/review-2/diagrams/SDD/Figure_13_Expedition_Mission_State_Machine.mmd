
stateDiagram-v2
    direction TB

    [*] --> Running

    state "Active Expedition - Host Authority" as Running {
        [*] --> CoreObjective

        CoreObjective --> Zone2Objective : Core objectives completed

        state "Zone 2 Objectives" as Zone2Objective {
            [*] --> FindSecurityTerminal

            FindSecurityTerminal --> RepairRelays : Terminal discovered
            RepairRelays --> SecurityHoldReady : All four relays online
            SecurityHoldReady --> SecurityHold : Authorized hold started
            SecurityHold --> SecurityHoldReady : No active operators
            SecurityHoldReady --> RepairRelays : Relay retry window expired
            SecurityHold --> RepairRelays : Relay retry window expired
            SecurityHold --> AuthorizationCodeGranted : Hold timer completed
            AuthorizationCodeGranted --> Zone2Completed : Valid access code accepted
            Zone2Completed --> [*]
        }

        Zone2Objective --> Zone3FindFrigate : Zone 2 access accepted
        Zone3FindFrigate --> Zone3PushFrigate : Authorized frigate push
        Zone3PushFrigate --> FinalHunt : Zone 3 charge completed
        FinalHunt --> Escape : Valid exit interaction
    }

    Running --> MatchEnded : Authoritative match result committed
    MatchEnded --> [*]

    %% Puzzle and SecurityHold in NetworkMatchPhase are retained legacy values.
    %% The active Security Hold is Zone2MissionStage.SecurityHold within Zone2Objective.
    %% Zone 2 completion and transition to Zone 3 occur in one authoritative operation.
    %% MatchEnded stores the terminal phase; Win/Lose is a separate result value.
