{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "EchoProtocol",
    "Audience": "EchoProtocol.Client",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 14
  },
  "MongoDb": {
    "DatabaseName": "echo_protocol_telemetry",
    "TelemetryCollectionName": "telemetry_events",
    "MaxBatchSize": 500,
    "SupportedSchemaVersion": "1.1",
    "MaxValueJsonBytes": 32768,
    "MaxFutureSkewMinutes": 5,
    "MaxEventAgeDays": 7
  },
  "MatchAuthority": {
    "EnableRemoteFixedTest": false,
    "JoinProofLifetimeSeconds": 120,
    "LeaseLifetimeSeconds": 45,
    "TelemetryDelegationRetentionHours": 24
  },
  "Loadout": {
    "TeamToolSlotCount": 1
  },
  "AEDPreMatchPolicy": {
    "Enabled": false,
    "PolicyVersion": "AED_SCENARIO_POLICY_V1_1",
    "PolicyConfigVersion": "AED_POLICY_CONFIG_V1_1",
    "EvidencePolicyVersion": "AED_EVIDENCE_POLICY_V1_1",
    "ParameterRegistryVersion": "AED_PARAMETER_REGISTRY_V1_1",
    "ContentWhitelistVersion": "M2-WHITELIST-1",
    "SurvivalLowThreshold": 30,
    "SurvivalHighThreshold": 70,
    "NoiseLowThreshold": 30,
    "NoiseHighThreshold": 70,
    "MinimumSurvivalSampleCountPerObservedPlayer": 1,
    "MinimumNoiseSampleCountPerObservedPlayer": 1,
    "RequireFullRosterObservedCoverage": true,
    "SupportItemBudgetCandidateValues": [0, 1, 2],
    "ChaseSpeedCandidateValues": [9, 10, 11]
  },
