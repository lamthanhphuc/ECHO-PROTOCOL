# Copy this file to .env for local development. Replace placeholders locally.
POSTGRES_DB=echo_protocol
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5433

MONGO_ROOT_USERNAME=echo_root
MONGO_ROOT_PASSWORD=<local-mongodb-password>
MONGO_DATABASE=echo_protocol_telemetry
MONGO_PORT=27018

# ASP.NET Core reads double underscores as nested configuration keys.
# Used when running the backend directly on the host with dotnet run.
# Docker Compose overrides database hosts and internal ports for the backend container.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=echo_protocol;Username=postgres;Password=<local-postgres-password>
ConnectionStrings__MongoDb=mongodb://echo_root:<local-mongodb-password>@localhost:27018/?authSource=admin
JwtSettings__SecretKey=<at-least-32-byte-local-jwt-secret>
MatchAuthority__ProofSigningKey=<different-at-least-32-byte-local-proof-secret>
MatchAuthority__JoinProofLifetimeSeconds=120
MatchAuthority__LeaseLifetimeSeconds=45
MatchAuthority__TelemetryDelegationRetentionHours=24
MongoDb__DatabaseName=echo_protocol_telemetry
MongoDb__TelemetryCollectionName=telemetry_events
MongoDb__MaxBatchSize=500
MongoDb__SupportedSchemaVersion=1.1
MongoDb__MaxValueJsonBytes=32768
MongoDb__MaxFutureSkewMinutes=5
MongoDb__MaxEventAgeDays=7

# Optional development-only admin seed. Leave unset to skip seeding.
AdminSeed__Email=
AdminSeed__Username=
AdminSeed__Password=
AdminSeed__DisplayName=
AdminSeed__InitialWalletBalance=0
