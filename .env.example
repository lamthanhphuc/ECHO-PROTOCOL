# Copy this file to .env for local development. Replace placeholders locally.
POSTGRES_DB=echo_protocol
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5433

# ASP.NET Core reads double underscores as nested configuration keys.
# Used when running the backend directly on the host with dotnet run.
# Docker Compose overrides this for the backend container with Host=postgres;Port=5432.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=echo_protocol;Username=postgres;Password=CHANGE_ME
JwtSettings__SecretKey=CHANGE_ME_WITH_LONG_LOCAL_DEV_SECRET

# Optional development-only admin seed. Leave unset to skip seeding.
AdminSeed__Email=
AdminSeed__Username=
AdminSeed__Password=
AdminSeed__DisplayName=
AdminSeed__InitialWalletBalance=0
